# Copy to .env and fill in. Docker Compose reads this file as well as the app.

# Compose files this machine uses, ":"-separated.
#   Dev PC (GPU):  docker-compose.yml:docker-compose.dev.yml:docker-compose.gpu.yml
#   ZimaOS (CPU):  docker-compose.yml
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml:docker-compose.gpu.yml

# Host folder for the database and all media.
DATA_DIR=./data
# Host port for the gallery.
PORT=8000
# IANA timezone used for date grouping, e.g. Europe/London.
TZ=UTC

# Notion integration:
#   1. https://www.notion.so/profile/integrations -> New integration, type Internal.
#      Capabilities: Read, Update and Insert content. Copy its secret into NOTION_TOKEN.
#   2. Open the database in Notion -> "..." menu -> Connections -> add the integration.
#   3. NOTION_DATA_SOURCE_ID: the 32-character ID in the database's URL (before "?v=").
# On first pull the app adds Status, Error, Summary and AI Tags to the database.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
# Property names, if yours differ from these defaults.
NOTION_PROP_URL=URL
NOTION_PROP_CAPTION=Caption
NOTION_PROP_TAGS=Tags
NOTION_PROP_STATUS=Status
NOTION_PROP_ERROR=Error
NOTION_PROP_SUMMARY=Summary
NOTION_PROP_AI_TAGS=AI Tags

# Local AI services. The defaults are the containers in this stack; on ZimaOS,
# point OLLAMA_URL at the PC (http://<pc>:11434) to use its GPU.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3.5:9b
WHISPER_URL=http://whisper:8000
WHISPER_MODEL=Systran/faster-whisper-small.en

# Sync processing.
# Frames from each video shown to the model; 0 skips them (faster on the N100).
KEYFRAMES=4
# Longer videos are marked Failed; 0 means no limit.
MAX_DURATION_MIN=0
# Sync stops downloading at 95% of this.
DISK_CAP_GB=100

# Reddit and age-restricted Instagram posts need a logged-in session: export cookies.txt
# (Netscape format) from a browser signed in to a secondary account, and save it as
# DATA_DIR/cookies.txt.
